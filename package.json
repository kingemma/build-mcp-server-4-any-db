{
  "name": "mcp-builder",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Server Build：为任意数据库可视化构建 MCP Server（Electron + Vue 3 + Node.js + GraphJin）",
  "author": {
    "name": "Evan, Zhen Wang",
    "email": "18901599114@163.com",
    "url": "tel:+8618901599114"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/dev-all.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare:binaries": "node scripts/prepare-binaries.js",
    "fetch:binaries": "node scripts/fetch-binaries.js",
    "check:binaries": "node scripts/check-binaries.js",
    "smoke:binaries": "node scripts/smoke-binaries.js",
    "demo:db": "node scripts/create-demo-db.js",
    "demo:orders": "node scripts/seed-demo-orders.js",
    "test": "npm run test:frontend && npm --prefix sidecar-backend test",
    "test:frontend": "node --test \"src/utils/*.test.mjs\"",
    "backend": "node sidecar-backend/src/index.js",
    "backend:demo": "npm run demo --prefix sidecar-backend",
    "verify:ui": "node scripts/verify-ui.js",
    "electron:dev": "electron .",
    "electron:serve": "npm run build && electron .",
    "dist:win": "npm run check:binaries && npm run build && electron-builder --win nsis",
    "dist:mac": "npm run check:binaries && npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run check:binaries && npm run build && electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.mcpbuilder.desktop",
    "productName": "MCP Server Build",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/mcp-build-server.png",
      "sidecar-backend/src/**/*",
      "sidecar-backend/package.json",
      "graphjin-binaries/version.json",
      "scripts/platforms.js",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "binaries",
        "to": "binaries",
        "filter": [
          "graphjin-*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MCP Server Build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Evan, Zhen Wang <18901599114@163.com>",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.15",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.7"
  }
}
