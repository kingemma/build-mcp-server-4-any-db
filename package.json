{
  "name": "mcp-builder",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Server 可视化构建平台：Electron 外壳 + Vue 3 前端 + Node.js 后端 + GraphJin 内核",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare:binaries": "node scripts/prepare-binaries.js",
    "fetch:binaries": "node scripts/fetch-binaries.js",
    "smoke:binaries": "node scripts/smoke-binaries.js",
    "test": "npm run test:frontend && npm --prefix sidecar-backend test",
    "test:frontend": "node --test src/utils/policy.test.mjs",
    "backend": "node sidecar-backend/src/index.js",
    "backend:demo": "npm run demo --prefix sidecar-backend",
    "verify:ui": "node scripts/verify-ui.js",
    "electron:dev": "electron .",
    "electron:serve": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.mcpbuilder.desktop",
    "productName": "MCP Builder",
    "directories": {
      "output": "release-final"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "sidecar-backend/src/**/*",
      "sidecar-backend/package.json",
      "graphjin-binaries/version.json",
      "scripts/platforms.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src-tauri/binaries",
        "to": "binaries",
        "filter": [
          "graphjin-*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MCP Builder"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "MCP Builder"
    }
  },
  "dependencies": {
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.15",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.7"
  }
}
